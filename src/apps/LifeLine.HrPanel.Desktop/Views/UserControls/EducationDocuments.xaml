<UserControl x:Class="LifeLine.HrPanel.Desktop.Views.UserControls.EducationDocuments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LifeLine.HrPanel.Desktop.Views.UserControls" 
             xmlns:cc="clr-namespace:Shared.WPF.Resources.Controls;assembly=Shared.WPF" 
             xmlns:features="clr-namespace:LifeLine.HrPanel.Desktop.ViewModels.Features" 
             d:DataContext="{d:DesignInstance Type=features:EducationDocumentsVM}"
             xmlns:enum="clr-namespace:LifeLine.HrPanel.Desktop.Enums"
             mc:Ignorable="d" 
             d:Height="auto" 
             d:Width="1000">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Arial"/>
            </Style>
            
            <!-- СТИЛЬ ДЛЯ ГРУППИРОВКИ -->
            <Style x:Key="DataGrid.GroupItemStyle" TargetType="GroupItem">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0,0,0,5"/>
                <Setter Property="Background" Value="{StaticResource App.MainColor}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <Grid Margin="{TemplateBinding Margin}" HorizontalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ToggleButton x:Name="ExpanderButton" 
                                              IsChecked="True"
                                              Cursor="Hand"
                                              Background="{TemplateBinding Background}"
                                              Padding="{TemplateBinding Padding}"
                                              BorderThickness="0"
                                              HorizontalContentAlignment="Stretch">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="3"
                                                    Margin="{TemplateBinding Padding}" 
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Стрелка по умолчанию (вниз) -->
                                        <Path x:Name="ArrowPath" Fill="White" Margin="13,0,0,0" VerticalAlignment="Center"
                                              Data="M 0 0 L 4 4 L 8 0 Z"/>

                                        <WrapPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource SaveStatusToStringConverter}}" FontWeight="Bold" FontSize="18" Foreground="#A0D0FF" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" FontSize="18" Foreground="#88FFFFFF" Margin="8,0,8,0" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </Grid>
                                </ToggleButton>

                                <!-- DataGrid автоматически подставляет DataGridRowsPresenter внутрь ItemsPresenter -->
                                <ItemsPresenter x:Name="ItemsPanel" Grid.Row="1" SnapsToDevicePixels="True"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger SourceName="ExpanderButton" Property="IsChecked" Value="False">
                                    <Setter TargetName="ItemsPanel" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="ArrowPath" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                                    <!-- Стрелка вверх -->
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список документов об образовании -->
        <Border Grid.Column="0" Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="0 0 5 0">
            <Border Margin="5" Background="{StaticResource App.MainColor}" CornerRadius="6" BorderBrush="#386FD6" BorderThickness="2">
                <DataGrid ItemsSource="{Binding EducationDocuments.EducationDocumentsView}" 
                          SelectedItem="{Binding EducationDocuments.SelectedLocalEducationDocument}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          HorizontalContentAlignment="Stretch" 
                          HeadersVisibility="Column"
                          Margin="2"
                          Background="{StaticResource App.MainColor}"
                          d:ItemsSource="{d:SampleData ItemCount=10}">

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <StaticResource ResourceKey="DataGrid.GroupItemStyle"/>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    
                    <DataGrid.Columns>
                        <!-- Тип документа -->
                        <DataGridTemplateColumn Header="Тип документа" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DocumentType.Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Уровень образования -->
                        <DataGridTemplateColumn Header="Уровень образования" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EducationLevel.Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--Информация-->
                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="25" Style="{StaticResource Button.Icon}">
                                        <Control Template="{StaticResource Magnifier}"/>
                                        <Button.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DocumentType.Name, StringFormat=Тип документа: {0}}"/>
                                                <TextBlock Text="{Binding EducationLevel.Name, StringFormat=Уровень образования: {0}}"/>
                                                <TextBlock Text="{Binding DocumentNumber, StringFormat=Норме: {0}}"/>
                                                <TextBlock Text="{Binding IssuedDate, StringFormat=Дата выдачи: {0}}"/>
                                                <TextBlock Text="{Binding OrganizationName, StringFormat=Наименование организации: {0}}"/>
                                                <TextBlock Text="{Binding QualificationAwardedName, StringFormat=Наименование присвоеной квалификации: {0}}"/>
                                                <TextBlock Text="{Binding SpecialtyName, StringFormat=Наименование специальности: {0}}"/>
                                                <TextBlock Text="{Binding ProgramName, StringFormat=Наименование программы: {0}}"/>
                                                <TextBlock Text="{Binding TotalHours, StringFormat=Кол-во часов: {0}}"/>
                                                <TextBlock Text="{Binding FilePath, StringFormat=Файл: {0}}"/>
                                            </StackPanel>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!--Удалить-->
                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="25" Foreground="#F06870" 
                                            Command="{Binding DataContext.DeleteEducationDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding }" 
                                            Style="{StaticResource Button.Icon}">
                                        <Control Template="{StaticResource Trash}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>


        <Border Grid.Column="1"  Background="{StaticResource App.SecondColor}" CornerRadius="6">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Уровень образования / Тип документа -->
                <StackPanel Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" 
                                  ItemsSource="{Binding DocumentTypes}" 
                                  SelectedItem="{Binding EducationDocuments.Display.DocumentType}"
                                  DisplayMemberPath="Name" 
                                  Margin="0 0 5 0"/>

                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding EducationLevels}" 
                                  SelectedItem="{Binding EducationDocuments.Display.EducationLevel}"
                                  DisplayMemberPath="Name" 
                                  Margin="5 0 0 0"/>
                    </Grid>

                    <!-- Номер документа / Дата выдачи -->
                    <Grid Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <cc:PlaceHolderTextBox Grid.Column="0" PlaceHolder="Номер документа*" Margin="0 0 5 0" 
                                               Text="{Binding EducationDocuments.Display.DocumentNumber}" Style="{StaticResource TextBox.PlaceHolder}"/>

                        <DatePicker Grid.Column="1" SelectedDate="{Binding EducationDocuments.Display.IssuedDate}" Margin="5 0 0 0"/>
                    </Grid>

                    <!-- Наименование организации / Наименование квалификации -->
                    <Grid Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <cc:PlaceHolderTextBox Grid.Column="0" PlaceHolder="Наименование организации*" Margin="0 0 5 0"
                                               Text="{Binding EducationDocuments.Display.OrganizationName}" Style="{StaticResource TextBox.PlaceHolder}"/>

                        <cc:PlaceHolderTextBox Grid.Column="1" PlaceHolder="Наименование квалификации" Margin="5 0 0 0"
                                               Text="{Binding EducationDocuments.Display.QualificationAwardedName}" Style="{StaticResource TextBox.PlaceHolder}"/>
                    </Grid>

                    <!-- Наименование специальности / Наименование программы -->
                    <Grid Margin="0 10 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <cc:PlaceHolderTextBox Grid.Column="0" PlaceHolder="Наименование специальности" Margin="0 0 5 0"
                                               Text="{Binding EducationDocuments.Display.SpecialtyName}" Style="{StaticResource TextBox.PlaceHolder}"/>

                        <cc:PlaceHolderTextBox Grid.Column="1" PlaceHolder="Наименование программы" Margin="5 0 0 0"
                                               Text="{Binding EducationDocuments.Display.ProgramName}" Style="{StaticResource TextBox.PlaceHolder}"/>
                    </Grid>

                    <!-- Количество часов -->
                    <cc:PlaceHolderTextBox Grid.Column="1" PlaceHolder="Количество часов" Margin="0 10 0 0"
                                           Text="{Binding EducationDocuments.Display.TotalHours}" Style="{StaticResource TextBox.PlaceHolder}"/>

                    <!-- Файл -->
                    <StackPanel Grid.Row="1" Margin="0 10 0 0">
                        <Button Content="Выбрать скан" 
                                Width="170" Height="40" 
                                HorizontalAlignment="Right" Margin="0 0 0 5"
                                Command="{Binding EducationDocuments.SelectMultipleCommand}" 
                                Style="{StaticResource App.Button}"/>

                        <ListView ItemsSource="{Binding EducationDocuments.PendingFilePaths}"
                                  d:ItemsSource="{d:SampleData ItemCount=10}"
                                  Background="#1E1E1E"
                                  Style="{StaticResource Custom.ListView}"
                                  ItemContainerStyle="{StaticResource Custom.ListViewItem}">

                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" IsItemsHost="True" Margin="0"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource App.SecondColor}" CornerRadius="6">
                                        <Border BorderBrush="#386FD6" 
                                                Background="{StaticResource App.MainColor}" 
                                                BorderThickness="2" 
                                                CornerRadius="10" 
                                                HorizontalAlignment="Left" 
                                                VerticalAlignment="Top" 
                                                Margin="5">
                                            <StackPanel>
                                                <Border BorderThickness="0 0 0 2" BorderBrush="#386FD6">
                                                    <StackPanel>
                                                        <Grid Width="150" Height="150" Margin="5">
                                                            <Image Source="{Binding Thumbnail}" 
                                                                   d:Source="C:\Users\texno\Documents\Lightshot\Screenshot_4.png"
                                                                   Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibilityConverter}}"/>

                                                            <TextBlock Text="{Binding FileExtension}"
                                                                       FontSize="24"
                                                                       FontWeight="Bold"
                                                                       Foreground="#AAAAAA"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding Thumbnail, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                                                        </Grid>

                                                        <TextBlock Text="{Binding Index, StringFormat='#{0}'}"
                                                                   HorizontalAlignment="Center" 
                                                                   FontSize="18" 
                                                                   Margin="0 0 0 2"
                                                                   Foreground="White"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding FileName}"
                                                                   HorizontalAlignment="Center" 
                                                                   FontSize="12" 
                                                                   Margin="0 0 0 2"
                                                                   Foreground="#AAAAAA"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="140"/>
                                                        <TextBlock Text="{Binding FileSizeFormatted}"
                                                                   HorizontalAlignment="Center" 
                                                                   FontSize="10" 
                                                                   Margin="0 0 0 5"
                                                                   Foreground="#666666"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Кнопки управления -->
                                                <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 2 0 2">
                                                    <Button Width="25" 
                                                            Background="Transparent" 
                                                            BorderThickness="0"
                                                            Margin="0 0 10 0"
                                                            Command="{Binding DataContext.EducationDocuments.PreviewCommand, 
                                                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding }"
                                                            Style="{StaticResource Button.Icon}">
                                                        <Control Template="{StaticResource Magnifier}"/>
                                                    </Button>
                                                    <Button Width="25" 
                                                            Background="Transparent" 
                                                            BorderThickness="0"
                                                            Foreground="#F06870"
                                                            Margin="10 0 0 0"
                                                            Command="{Binding DataContext.EducationDocuments.RemovePendingFileCommand, 
                                                                                RelativeSource={RelativeSource AncestorType=ListView}}"
                                                            CommandParameter="{Binding }"
                                                            Style="{StaticResource Button.Icon}">
                                                        <Control Template="{StaticResource Trash}"/>
                                                        <Button.ToolTip>
                                                            <TextBlock Text="Удалить"/>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="1" Content="Добавить локально" Height="40"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                        Command="{Binding EducationDocuments.AddEducationDocumentCommandAsync}" 
                        Style="{StaticResource App.Button}" Margin="0 10 0 0"/>

                <Button Grid.Row="2" Content="Продолжить" Height="40"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                        Command="{Binding ExecuteStepCommand}" 
                        CommandParameter="{x:Static enum:EmployeeCreationSteps.WorkPermits}"
                        Visibility="{Binding Action, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TypeActionConverter}, ConverterParameter={x:Static enum:TypeAction.CreateStep}, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource App.Button}" Margin="0 10 0 0"/>

                <Button Grid.Row="2" Content="Сохранить" Height="40"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                        Command="{Binding CreateEducationdocumentCommand}" 
                        Visibility="{Binding Action, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TypeActionConverter}, ConverterParameter={x:Static enum:TypeAction.Create}, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource App.Button}" Margin="0 10 0 0"/>

                <Button Grid.Row="2" Content="Обновить" Height="40"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                        Command="{Binding UpdateEducationdocumentCommand}" 
                        Visibility="{Binding Action, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TypeActionConverter}, ConverterParameter={x:Static enum:TypeAction.Update}, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource App.Button}" Margin="0 10 0 0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
