<UserControl x:Class="LifeLine.HrPanel.Desktop.Views.UserControls.ContactInformation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:cc="clr-namespace:Shared.WPF.Resources.Controls;assembly=Shared.WPF" 
             xmlns:features="clr-namespace:LifeLine.HrPanel.Desktop.ViewModels.Features" 
             d:DataContext="{d:DesignInstance Type=features:ContactInformationVM}"
             xmlns:enum="clr-namespace:LifeLine.HrPanel.Desktop.Enums"
             mc:Ignorable="d" 
             d:Height="auto" 
             d:Width="auto">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Arial"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Grid.Column="0" Background="{StaticResource App.SecondColor}" CornerRadius="6">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Контактная информация -->
                <Grid Grid.Column="0" Margin="0 0 5 0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Персональная -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Персональная" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 0 0 5"/>
                        
                        <cc:PlaceHolderTextBox PlaceHolder="Телефон*" Margin="0 0 0 5" 
                                               Text="{Binding ContactInformation.Display.PersonalPhone}" 
                                               Style="{StaticResource TextBox.PlaceHolder}"/>

                        <cc:PlaceHolderTextBox PlaceHolder="Почта*" 
                                               Text="{Binding ContactInformation.Display.PersonalEmail}" 
                                               Style="{StaticResource TextBox.PlaceHolder}"/>
                    </StackPanel>

                    <!-- Корпоративная -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Корпоративная" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 0 0 5"/>
                        
                        <cc:PlaceHolderTextBox PlaceHolder="Телефон" Margin="0 0 0 5" 
                                               Text="{Binding ContactInformation.Display.CorporatePhone}" 
                                               Style="{StaticResource TextBox.PlaceHolder}"/>

                        <cc:PlaceHolderTextBox PlaceHolder="Почта" 
                                               Text="{Binding ContactInformation.Display.CorporateEmail}" 
                                               Style="{StaticResource TextBox.PlaceHolder}"/>
                    </StackPanel>
                </Grid>

                <!-- Место проживания -->
                <StackPanel Grid.Column="1" Margin="5 0 0 0">
                    <TextBlock Text="Адрес" FontSize="20" HorizontalAlignment="Center" Margin="0 0 0 5"/>

                    <!-- Код -->
                    <cc:PlaceHolderTextBox PlaceHolder="Код*" Margin="0 0 0 5"
                           Text="{Binding ContactInformation.Display.PostalCode}" 
                           Style="{StaticResource TextBox.PlaceHolder}"/>
                    <!-- Регион -->
                    <cc:PlaceHolderTextBox PlaceHolder="Регион*" Margin="0 0 0 5"
                           Text="{Binding ContactInformation.Display.Region}" 
                           Style="{StaticResource TextBox.PlaceHolder}"/>
                    <!-- Город -->
                    <cc:PlaceHolderTextBox PlaceHolder="Город*" Margin="0 0 0 5"
                           Text="{Binding ContactInformation.Display.City}" 
                           Style="{StaticResource TextBox.PlaceHolder}"/>
                    <!-- Улица -->
                    <cc:PlaceHolderTextBox PlaceHolder="Улица*" Margin="0 0 0 5"
                           Text="{Binding ContactInformation.Display.Street}" 
                           Style="{StaticResource TextBox.PlaceHolder}"/>
                    <!-- Дом / Строение -->
                    <cc:PlaceHolderTextBox PlaceHolder="Дом / Строение*" Margin="0 0 0 5"
                           Text="{Binding ContactInformation.Display.Building}" 
                           Style="{StaticResource TextBox.PlaceHolder}"/>
                    <!-- Квартира -->
                    <cc:PlaceHolderTextBox PlaceHolder="Квартира"
                           Text="{Binding ContactInformation.Display.Apartment}" 
                           Style="{StaticResource TextBox.PlaceHolder}"/>
                </StackPanel>
            </Grid>

            <Button Grid.Row="1" Content="Добавить контактную информацию" Height="40"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                            Command="{Binding ExecuteStepCommand}" 
                            CommandParameter="{x:Static enum:EmployeeCreationSteps.PersonalDocuments}"
                            Visibility="{Binding Action, 
                                                 RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                 Converter={StaticResource TypeActionConverter}, 
                                                 ConverterParameter={x:Static enum:TypeAction.CreateStep}, 
                                                 UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource App.Button}" Margin="0 10 0 0"/>

            <Button Grid.Row="1" Content="Обновить контактную информацию" Height="40"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                            Command="{Binding UpdateContactInformationCommand}" 
                            Visibility="{Binding Action, 
                                                 RelativeSource={RelativeSource AncestorType=UserControl}, 
                                                 Converter={StaticResource TypeActionConverter}, 
                                                 ConverterParameter={x:Static enum:TypeAction.Update}, 
                                                 UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource App.Button}" Margin="0 10 0 0"/>
        </Grid>
    </Border>
</UserControl>
