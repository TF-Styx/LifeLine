<UserControl x:Class="LifeLine.HrPanel.Desktop.Views.UserControls.Specialties"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LifeLine.HrPanel.Desktop.Views.UserControls"
             xmlns:enum="clr-namespace:LifeLine.HrPanel.Desktop.Enums" 
             xmlns:features="clr-namespace:LifeLine.HrPanel.Desktop.ViewModels.Features" 
             xmlns:cc="clr-namespace:Shared.WPF.Resources.Controls;assembly=Shared.WPF"
             xmlns:helpers="clr-namespace:Shared.WPF.Resources.Attachables;assembly=Shared.WPF"
             d:DataContext="{d:DesignInstance Type=features:SpecialtiesVM}"
             mc:Ignorable="d" 
             d:Height="auto" 
             d:Width="auto">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10 0">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0 5 0 0">
                        <DockPanel DockPanel.Dock="Right">
                            <!-- Фильтр -->
                            <Button Height="30" Foreground="White"
                                    Style="{StaticResource Button.Icon}">
                                <Control Template="{StaticResource Filter}"/>
                            </Button>
                            <!-- Обновить -->
                            <Button Height="30" Margin="5 0 0 0" Foreground="White"
                                    Command="{Binding RefreshCommandAsync}" 
                                    Style="{StaticResource Button.Icon}">
                                <Control Template="{StaticResource Refresh}"/>
                            </Button>
                        </DockPanel>
                        <DockPanel HorizontalAlignment="Stretch" Margin="0 0 5 0">
                            <!-- Сортировка -->
                            <ComboBox DockPanel.Dock="Right"
                                      DisplayMemberPath="Name" 
                                      MinWidth="200"/>
                            <!-- Поиск -->
                            <cc:PlaceHolderTextBox PlaceHolder="Поиск документа" Margin="0 0 10 0" 
                                                   Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" 
                                                   helpers:TextBoxHelper.Icon="{StaticResource Search}" 
                                                   Style="{StaticResource TextBox.PlaceHolder.WithIcon}"
                                                   Background="{StaticResource App.MainColor}"/>
                        </DockPanel>
                    </DockPanel>
                </DockPanel>

                <Border DockPanel.Dock="Top" Margin="10" Background="{StaticResource App.MainColor}" CornerRadius="6" BorderBrush="#386FD6" BorderThickness="2">
                    <ListView ItemsSource="{Binding LocalEmployeeSpecialties}" 
                              Style="{StaticResource Custom.ListView}"
                              ItemContainerStyle="{StaticResource Custom.ListViewItem}"
                              d:ItemsSource="{d:SampleData ItemCount=4}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" Background="{StaticResource App.SecondColor}" CornerRadius="6" BorderBrush="#FF5739B1" BorderThickness="1">
                                    <DockPanel Margin="10">
                                        <!--Кнопки управления-->
                                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <!-- Информация -->
                                            <Button Width="20" Margin="0 0 5 0" 
                                                    Foreground="#FF5B8FEF" 
                                                    Style="{StaticResource Button.Icon}">
                                                <Control Template="{StaticResource Info}"/>
                                                <Button.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding SpecialtyName, StringFormat=Наименвоание специализации: {0}}"/>
                                                        <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"/>
                                                    </StackPanel>
                                                </Button.ToolTip>
                                            </Button>

                                            <!-- Удалить -->
                                            <Button Width="20" Margin="0 0 0 0" 
                                                Foreground="#F06870" ToolTip="Удалить"
                                                Command="{Binding DataContext.DeleteCommandAsync, 
                                                                  RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                CommandParameter="{Binding }" 
                                                Style="{StaticResource Button.Icon}">
                                                <Control Template="{StaticResource Trash1}"/>
                                            </Button>
                                        </WrapPanel>

                                        <UniformGrid Columns="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SpecialtyName, StringFormat=Наименование: {0}}" 
                                                       ToolTip="{Binding SpecialtyName, StringFormat=Наименование: {0}}" 
                                                       HorizontalAlignment="Stretch" TextAlignment="Center" Margin="0 0 5 0"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                                            <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}" 
                                                       ToolTip="{Binding Description, StringFormat=Описание: {0}}" 
                                                       HorizontalAlignment="Stretch" TextAlignment="Center" Margin="5 0 0 0"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </UniformGrid>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <StackPanel Margin="5">

                    <ComboBox ItemsSource="{Binding Specialties}" 
                              SelectedItem="{Binding SelectedSpecialty}"
                              DisplayMemberPath="SpecialtyName"/>

                    <Button Content="Сохранить" Height="40"
                            HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Command="{Binding CreateCommandAsync}" 
                            Style="{StaticResource App.Button}" Margin="0 10 0 0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
