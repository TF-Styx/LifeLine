<UserControl x:Class="LifeLine.HrPanel.Desktop.Views.UserControls.ManagementHospital.Position.PositionList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LifeLine.HrPanel.Desktop.Views.UserControls.ManagementHospital.Position"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:behaviors="clr-namespace:Shared.WPF.Resources.Behaviors;assembly=Shared.WPF" 
             xmlns:position="clr-namespace:LifeLine.HrPanel.Desktop.ViewModels.Features.ManagementHospital.Position" 
             xmlns:helpers="clr-namespace:Shared.WPF.Resources.Attachables;assembly=Shared.WPF"
             xmlns:cc="clr-namespace:Shared.WPF.Resources.Controls;assembly=Shared.WPF"
             d:DataContext="{d:DesignInstance Type=position:PositionListVM}"
             mc:Ignorable="d" 
             d:Height="auto" 
             d:Width="606">

    <b:Interaction.Behaviors>
        <behaviors:AsyncInitializeBehavior/>
    </b:Interaction.Behaviors>

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Arial"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Grid.Column="0" Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="10 0">
                <TextBlock Text="{Binding CurrentDepartmentName, 
                                          StringFormat=Должности для: {0}}" 
                           ToolTip="{Binding CurrentDepartmentName}" DockPanel.Dock="Top"
                           d:Text="Должности для: Эндокринное отделение" TextWrapping="NoWrap"
                           FontSize="30" HorizontalAlignment="Center" Margin="0 0 0 0"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0 5 0 0">
                    <DockPanel DockPanel.Dock="Right">
                        <!-- Фильтр -->
                        <Button Height="30" Foreground="White"
                                Style="{StaticResource Button.Icon}">
                            <Control Template="{StaticResource Filter}"/>
                        </Button>
                        <!-- Обновить -->
                        <Button Height="30" Margin="5 0 0 0" Foreground="White"
                                Command="{Binding RefreshCommandAsync}" 
                                Style="{StaticResource Button.Icon}">
                            <Control Template="{StaticResource Refresh}"/>
                        </Button>
                        <!-- Добавить -->
                        <Button Height="30" Margin="5 0 0 0"
                                Command="{Binding EditPositionCommand}" 
                                Style="{StaticResource Button.Icon}">
                            <Control Template="{StaticResource AddIcon}"/>
                        </Button>
                    </DockPanel>
                    <DockPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0 0 5 0">
                        <!-- Сортировка -->
                        <ComboBox DockPanel.Dock="Right"
                                  DisplayMemberPath="Name" 
                                  MinWidth="200"/>
                        <!-- Поиск -->
                        <cc:PlaceHolderTextBox PlaceHolder="Поиск должности" Margin="0 0 10 0"
                                               Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" 
                                               helpers:TextBoxHelper.Icon="{StaticResource Search}" 
                                               Style="{StaticResource TextBox.PlaceHolder.WithIcon}"
                                               Background="{StaticResource App.MainColor}"/>
                    </DockPanel>
                </DockPanel>
            </DockPanel>

            <Border Margin="10" Background="{StaticResource App.MainColor}" CornerRadius="6" BorderBrush="#386FD6" BorderThickness="2">
                <ListView ItemsSource="{Binding Positions}" 
                          SelectedItem="{Binding Position}"
                          Style="{StaticResource Custom.ListView}"
                          ItemContainerStyle="{StaticResource Custom.ListViewItem}"
                          d:ItemsSource="{d:SampleData ItemCount=4}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" IsItemsHost="True" Margin="0"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" Background="{StaticResource App.SecondColor}" CornerRadius="6" BorderBrush="#FF5739B1" BorderThickness="1" Width="270" MaxHeight="300">
                                <StackPanel Margin="10">
                                    <!--Кнопки управления-->
                                    <WrapPanel Margin="0 0 0 5" HorizontalAlignment="Right">
                                        <!-- Информация -->
                                        <Button  Width="20" Margin="0 0 5 0"  
                                                 Foreground="#FF5B8FEF" 
                                                 Style="{StaticResource Button.Icon}">
                                            <Control Template="{StaticResource Info}"/>
                                            <Button.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name, StringFormat=Наименование: {0}}"/>
                                                    <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"/>
                                                </StackPanel>
                                            </Button.ToolTip>
                                        </Button>

                                        <!-- Редактирование -->
                                        <Button Width="20" Margin="0 0 5 0" 
                                                Foreground="#c7d22d" ToolTip="Редактирование"
                                                Command="{Binding DataContext.EditPositionCommand, 
                                                                  RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                CommandParameter="{Binding }"
                                                Style="{StaticResource Button.Icon}">
                                            <Control Template="{StaticResource Pencil}"/>
                                        </Button>

                                        <!-- Удалить -->
                                        <Button Width="20" Margin="0 0 0 0" 
                                                Foreground="#F06870" ToolTip="Удалить"
                                                Command="{Binding DataContext.DeletePositionCommandAsync, 
                                                                  RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                CommandParameter="{Binding }" 
                                                Style="{StaticResource Button.Icon}">
                                            <Control Template="{StaticResource Trash}"/>
                                        </Button>
                                    </WrapPanel>

                                    <DockPanel>
                                        <TextBlock Text="{Binding Name}" 
                                                   ToolTip="{Binding Name}"
                                                   TextWrapping="NoWrap" 
                                                   DockPanel.Dock="Top" 
                                                   TextAlignment="Center"
                                                   Margin="0 0 0 5" FontSize="18"
                                                   d:Text="Наименование должности"/>

                                        <TextBlock Text="{Binding Description}" 
                                                   ToolTip="{Binding Description}"
                                                   TextWrapping="Wrap" 
                                                   FontSize="18" MaxHeight="215"
                                                   d:Text="Описание должности"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
