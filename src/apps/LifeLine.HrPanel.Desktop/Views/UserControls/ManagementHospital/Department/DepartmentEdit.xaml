<UserControl x:Class="LifeLine.HrPanel.Desktop.Views.UserControls.ManagementHospital.Department.DepartmentEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LifeLine.HrPanel.Desktop.Views.UserControls.ManagementHospital.Department"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:behaviors="clr-namespace:Shared.WPF.Resources.Behaviors;assembly=Shared.WPF" 
             xmlns:cc="clr-namespace:Shared.WPF.Resources.Controls;assembly=Shared.WPF" 
             xmlns:department="clr-namespace:LifeLine.HrPanel.Desktop.ViewModels.Features.ManagementHospital.Department" 
             d:DataContext="{d:DesignInstance Type=department:DepartmentEditVM}"
             mc:Ignorable="d"
             d:Height="500" 
             d:Width="200">

    <b:Interaction.Behaviors>
        <behaviors:AsyncInitializeBehavior/>
    </b:Interaction.Behaviors>

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Arial"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
        <DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
                <!-- Основная информация -->
                <StackPanel Grid.Row="0" Margin="5">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" 
                                VerticalAlignment="Top" 
                                Foreground="#F06870" 
                                Width="25" Height="25" 
                                Command="{Binding CloseEditPanelCommand}"
                                Style="{StaticResource Button.Icon}">
                            <Control Template="{StaticResource Close1}"/>
                        </Button>
                        <TextBlock Text="Основная информация" FontSize="20" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 0 0 5"/>
                    </DockPanel>

                    <cc:PlaceHolderTextBox PlaceHolder="Наименование" Margin="0 0 0 5" 
                                           TextWrapping="Wrap" MaxHeight="500"
                                           Text="{Binding DepartmentProp.Name, 
                                                           UpdateSourceTrigger=PropertyChanged}" 
                                           Style="{StaticResource TextBox.PlaceHolder}"/>

                    <cc:PlaceHolderTextBox PlaceHolder="Описание" Margin="0 0 0 5" 
                                           TextWrapping="Wrap" MaxHeight="500"
                                           Text="{Binding DepartmentProp.Description, 
                                                          UpdateSourceTrigger=PropertyChanged}" 
                                           Style="{StaticResource TextBox.PlaceHolder}"/>

                    <cc:PlaceHolderTextBox PlaceHolder="Строение" 
                                           Margin="0 0 0 0" 
                                           Text="{Binding DepartmentProp.Building, 
                                                          UpdateSourceTrigger=PropertyChanged}" 
                                           Style="{StaticResource TextBox.PlaceHolder}"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Margin="5" VerticalAlignment="Bottom">
                <Button Content="Сохранить" Height="40"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Command="{Binding CreateDepartmentCommandAsync}"
                        Style="{StaticResource App.Button}" Margin="0 0 0 0"/>

                <Button Content="Обновить" Height="40"
                        HorizontalAlignment="Stretch" VerticalAlignment="Center"
                        Command="{Binding UpdateDepartmentCommandAsync}"
                        Style="{StaticResource App.Button}" Margin="0 10 0 0"/>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
