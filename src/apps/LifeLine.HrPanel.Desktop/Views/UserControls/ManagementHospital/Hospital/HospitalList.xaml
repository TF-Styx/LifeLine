<UserControl x:Class="LifeLine.HrPanel.Desktop.Views.UserControls.ManagementHospital.Hospital.HospitalList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LifeLine.HrPanel.Desktop.Views.UserControls.ManagementHospital.Hospital" 
             xmlns:hospital="clr-namespace:LifeLine.HrPanel.Desktop.ViewModels.Features.ManagementHospital.Hospital" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:behaviors="clr-namespace:Shared.WPF.Resources.Behaviors;assembly=Shared.WPF"
             d:DataContext="{d:DesignInstance Type=hospital:HospitalListVM}"
             mc:Ignorable="d" 
             d:Height="450" 
             d:Width="800">

    <b:Interaction.Behaviors>
        <behaviors:AsyncInitializeBehavior/>
    </b:Interaction.Behaviors>

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Arial"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Grid.Column="0" Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" 
                        Height="50" Margin="10 0"
                        Command="{Binding EditHospitalCommand}" 
                        Style="{StaticResource Button.Icon}">
                    <Control Template="{StaticResource AddIcon}"/>
                </Button>
                <DockPanel HorizontalAlignment="Center" Margin="0 5 0 0">
                    <TextBlock Text="Список больниц" DockPanel.Dock="Top" HorizontalAlignment="Center" FontSize="30" Margin="0 0 0 5"/>
                    <TextBlock Text="{Binding CurrentHospitalName, 
                                              StringFormat=Больница: {0}}" 
                               d:Text="Больница: Онкологическая больница"
                               FontSize="30" HorizontalAlignment="Center" Margin="0 0 0 0"/>
                </DockPanel>
            </DockPanel>

            <Border Margin="10" Background="{StaticResource App.MainColor}" CornerRadius="6" BorderBrush="#386FD6" BorderThickness="2">
                <DataGrid ItemsSource="{Binding Hospitals}" 
                          SelectedItem="{Binding Hospital}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          HorizontalContentAlignment="Stretch" 
                          HeadersVisibility="Column"
                          Margin="2"
                          Background="{StaticResource App.MainColor}"
                          d:ItemsSource="{d:SampleData ItemCount=10}">

                    <!--<DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <StaticResource ResourceKey="DataGrid.GroupItemStyle"/>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>-->

                    <DataGrid.Columns>

                        <!-- Наименование -->
                        <DataGridTemplateColumn Header="Наименование" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Описание -->
                        <DataGridTemplateColumn Header="Описание" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Телефон -->
                        <DataGridTemplateColumn Header="Телефон" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Phone}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Почта -->
                        <DataGridTemplateColumn Header="Почта" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Email}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Код -->
                        <DataGridTemplateColumn Header="Код" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PostalCode}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Регион -->
                        <DataGridTemplateColumn Header="Регион" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Region}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Город -->
                        <DataGridTemplateColumn Header="Город" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding City}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Улица -->
                        <DataGridTemplateColumn Header="Улица" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Street}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Информация -->
                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="25" Style="{StaticResource Button.Icon}">
                                        <Control Template="{StaticResource Magnifier}"/>
                                        <Button.ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name, StringFormat=Наименование: {0}}"/>
                                                <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"/>
                                                <TextBlock Text="{Binding Phone, StringFormat=Номер: {0}}"/>
                                                <TextBlock Text="{Binding Email, StringFormat=Почта: {0}}"/>
                                                <TextBlock Text="{Binding PostalCode, StringFormat=Код: {0}}"/>
                                                <TextBlock Text="{Binding Region, StringFormat=Регион: {0}}"/>
                                                <TextBlock Text="{Binding City, StringFormat=Город: {0}}"/>
                                                <TextBlock Text="{Binding Street, StringFormat=Улица: {0}}"/>
                                            </StackPanel>
                                        </Button.ToolTip>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Фильтр -->
                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="25" Foreground="#ffffff"
                                            Style="{StaticResource Button.Icon}">
                                        <Control Template="{StaticResource Filter}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Редактировать -->
                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="25" Foreground="#c7d22d"
                                            Command="{Binding DataContext.EditHospitalCommand, 
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding }"
                                            Style="{StaticResource Button.Icon}">
                                        <Control Template="{StaticResource Pencil}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Удалить -->
                        <DataGridTemplateColumn Width="35">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Width="25" Foreground="#F06870" Focusable="False" 
                                            Command="{Binding DataContext.DeleteHospitalCommandAsync, 
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding }"
                                            Style="{StaticResource Button.Icon}">
                                        <Control Template="{StaticResource Trash}"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
