<UserControl x:Class="LifeLine.HrPanel.Desktop.Views.UserControls.ManagementEmployee.Employee.EmployeeList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LifeLine.HrPanel.Desktop.Views.UserControls.ManagementEmployee.Employee" 
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors" 
             xmlns:behaviors="clr-namespace:Shared.WPF.Resources.Behaviors;assembly=Shared.WPF"
             mc:Ignorable="d" 
             d:Height="450" 
             d:Width="800">

    <b:Interaction.Behaviors>
        <behaviors:AsyncInitializeBehavior/>
    </b:Interaction.Behaviors>

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Arial"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="10 0">
                
            </DockPanel>
            <DockPanel>
                <ListView ItemsSource="{Binding Employyes}" 
                          SelectedItem="{Binding Employee}"
                          Style="{StaticResource Custom.ListView}"
                          ItemContainerStyle="{StaticResource Custom.ListViewItem}"
                          d:ItemsSource="{d:SampleData ItemCount=4}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5" Background="{StaticResource App.SecondColor}" CornerRadius="6" BorderBrush="#FF5739B1" BorderThickness="1">
                                <DockPanel Margin="10">
                                    <!--Кнопки управления-->
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <!-- Информация -->
                                        <Button Width="20" Margin="0 0 0 5" 
                                                Foreground="#FF5B8FEF" 
                                                Style="{StaticResource Button.Icon}">
                                            <Control Template="{StaticResource Info}"/>
                                            <Button.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Surname, StringFormat=Фамилия: {0}}"/>
                                                    <TextBlock Text="{Binding Name, StringFormat=Имя: {0}}"/>
                                                    <TextBlock Text="{Binding Patronymic, StringFormat=Отчество: {0}}"/>
                                                </StackPanel>
                                            </Button.ToolTip>
                                        </Button>

                                        <!-- Редактирование -->
                                        <Button Width="20" Margin="0 0 0 5" 
                                                Foreground="#c7d22d" ToolTip="Редактирование"
                                                Command="{Binding DataContext.EditBranchCommand, 
                                                                  RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                CommandParameter="{Binding }"
                                                Style="{StaticResource Button.Icon}">
                                            <Control Template="{StaticResource Pencil}"/>
                                        </Button>

                                        <!-- Удалить -->
                                        <Button Width="20" Margin="0 0 0 0" 
                                                Foreground="#F06870" ToolTip="Удалить"
                                                Command="{Binding DataContext.DeleteBranchCommandAsync, 
                                                                  RelativeSource={RelativeSource AncestorType=ListView}}" 
                                                CommandParameter="{Binding }" 
                                                Style="{StaticResource Button.Icon}">
                                            <Control Template="{StaticResource Archive}"/>
                                        </Button>
                                    </StackPanel>

                                    <DockPanel VerticalAlignment="Center">
                                        <DockPanel>
                                            <Image Width="75" Height="75" DockPanel.Dock="Left" Margin="0 0 10 0" Source="{Binding PersonalPhoto}" 
                                                   d:Source="C:\Users\texno\Documents\Lightshot\Screenshot_4.png"/>

                                            <StackPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="0 0 0 2.5">
                                                    <TextBlock Text="{Binding Surname}"/>
                                                    <TextBlock Text="{Binding Name}" Margin="5 0 5 0"/>
                                                    <TextBlock Text="{Binding Patronymic}"/>
                                                </DockPanel>

                                                <TextBlock Text="{Binding Department}" Margin="0 2.5" d:Text="IT"/>
                                                <TextBlock Text="{Binding Position}" Margin="0 2.5" d:Text="Разработчик"/>
                                                <TextBlock Text="{Binding Status}" Margin="0 2.5" d:Text="На работе"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DockPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </DockPanel>
    </Border>

</UserControl>
