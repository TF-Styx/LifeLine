<Page x:Class="LifeLine.HrPanel.Desktop.Views.Pages.EditDepartmentPositionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LifeLine.HrPanel.Desktop.Views.Pages" 
      xmlns:cc="clr-namespace:Shared.WPF.Resources.Controls;assembly=Shared.WPF" 
      xmlns:pages="clr-namespace:LifeLine.HrPanel.Desktop.ViewModels.Pages" 
      xmlns:b="http://schemas.microsoft.com/xaml/behaviors" 
      xmlns:behaviors="clr-namespace:Shared.WPF.Resources.Behaviors;assembly=Shared.WPF"
      d:DataContext="{d:DesignInstance Type=pages:EditDepartmentPositionPageVM}"
      mc:Ignorable="d" 
      d:Height="auto" 
      d:Width="800"
      Title="EditDepartmentPositionPage">

    <b:Interaction.Behaviors>
        <behaviors:AsyncInitializeBehavior/>
    </b:Interaction.Behaviors>

    <Page.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Arial"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ОТДЕЛ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- СПИСОК -->
            <Border Grid.Row="0" Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
                <DockPanel>
                    <TextBlock Grid.Row="0" Text="Отдел" 
                               FontSize="20" Margin="0 5 0 0"
                               HorizontalAlignment="Center" 
                               DockPanel.Dock="Top"/>
                    <Border Margin="10" Background="{StaticResource App.MainColor}" CornerRadius="6" BorderBrush="#386FD6" BorderThickness="2">
                        <DataGrid ItemsSource="{Binding Departments}" 
                                  SelectedItem="{Binding Department}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  HorizontalContentAlignment="Stretch" 
                                  HeadersVisibility="Column"
                                  Margin="2"
                                  Background="{StaticResource App.MainColor}"
                                  d:ItemsSource="{d:SampleData ItemCount=10}">
                            <DataGrid.Columns>

                                <!-- Наименование -->
                                <DataGridTemplateColumn Header="Наименование" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Описание -->
                                <DataGridTemplateColumn Header="Описание" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Адрес -->
                                <!--<DataGridTemplateColumn Header="Адрес" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Address}" 
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>-->

                                <!--Информация-->
                                <DataGridTemplateColumn Width="35">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="25" Style="{StaticResource Button.Icon}">
                                                <Control Template="{StaticResource Magnifier}"/>
                                                <Button.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name, StringFormat=Наименование: {0}}"/>
                                                        <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"/>
                                                        <!--<TextBlock Text="{Binding Address, StringFormat=Адрес: {0}}"/>-->
                                                    </StackPanel>
                                                </Button.ToolTip>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--Удалить-->
                                <DataGridTemplateColumn Width="35">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="25" Foreground="#F06870" 
                                                    Command="{Binding DataContext.DeleteDepartmentCommandAsync, 
                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding }" 
                                                    Style="{StaticResource Button.Icon}">
                                                <Control Template="{StaticResource Trash}"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ПОЛЯ -->
            <Border Grid.Row="1" Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Наименование / Описание -->
                            <StackPanel Margin="5">
                                <TextBlock Text="Наимевание" FontSize="18" Margin="0 0 0 5" HorizontalAlignment="Center"/>

                                <cc:PlaceHolderTextBox PlaceHolder="Наименование" Margin="0 0 0 5"
                                                       Text="{Binding DepartmentDis.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                                <cc:PlaceHolderTextBox PlaceHolder="Описание" Margin="0 0 0 0" TextWrapping="Wrap" MaxHeight="500"
                                                       Text="{Binding DepartmentDis.Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                            </StackPanel>

                            <!-- Адрес -->
                            <StackPanel Margin="5">
                                <TextBlock Text="Адрес" FontSize="18" Margin="0 0 0 5" HorizontalAlignment="Center"/>

                                <cc:PlaceHolderTextBox PlaceHolder="Код" Margin="0 0 0 5" 
                                                       Text="{Binding DepartmentDis.PostalCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                                <cc:PlaceHolderTextBox PlaceHolder="Регион" Margin="0 0 0 5"
                                                       Text="{Binding DepartmentDis.Region, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                                <cc:PlaceHolderTextBox PlaceHolder="Город" Margin="0 0 0 5"
                                                       Text="{Binding DepartmentDis.City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                                <cc:PlaceHolderTextBox PlaceHolder="Улица" Margin="0 0 0 5"
                                                       Text="{Binding DepartmentDis.Street, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                                <cc:PlaceHolderTextBox PlaceHolder="Строение/корпус" Margin="0 0 0 5"
                                                       Text="{Binding DepartmentDis.Building, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <Button Content="Сохранить" Margin="5"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CreateDepartmentCommandAsync}"
                                Style="{StaticResource App.Button}"/>

                        <Button Content="Обновить" Margin="5"
                                HorizontalAlignment="Stretch"
                                Command="{Binding UpdateDepartmentCommandAsync}"
                                Style="{StaticResource App.Button}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ДОЛЖНОСТЬ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- СПИСОК -->
            <Border Grid.Row="0" Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
                <DockPanel>
                    <TextBlock Grid.Row="0" Text="Должность" 
                               FontSize="20" Margin="0 5 0 0"
                               HorizontalAlignment="Center"
                               DockPanel.Dock="Top"/>
                    
                    <Border Margin="10" Background="{StaticResource App.MainColor}" CornerRadius="6" BorderBrush="#386FD6" BorderThickness="2">
                        <DataGrid ItemsSource="{Binding Positions}" 
                                  SelectedItem="{Binding Position}"
                                  AutoGenerateColumns="False" 
                                  CanUserAddRows="False"
                                  HorizontalContentAlignment="Stretch" 
                                  HeadersVisibility="Column"
                                  Margin="2"
                                  Background="{StaticResource App.MainColor}"
                                  d:ItemsSource="{d:SampleData ItemCount=10}">
                            <DataGrid.Columns>
                                
                                <!-- Наименование -->
                                <DataGridTemplateColumn Header="Наименование" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"  TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Описание -->
                                <DataGridTemplateColumn Header="Описание" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--Информация-->
                                <DataGridTemplateColumn Width="35">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="25" Command="{Binding DeleteImageCommand}" Style="{StaticResource Button.Icon}">
                                                <Control Template="{StaticResource Magnifier}"/>
                                                <Button.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name, StringFormat=Наименование: {0}}"/>
                                                        <TextBlock Text="{Binding Description, StringFormat=Описание: {0}}"/>
                                                    </StackPanel>
                                                </Button.ToolTip>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--Удалить-->
                                <DataGridTemplateColumn Width="35">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="25" Foreground="#F06870" 
                                                    Command="{Binding DataContext.DeletePositionCommandAsync, 
                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding }" 
                                                    Style="{StaticResource Button.Icon}">
                                                <Control Template="{StaticResource Trash}"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ПОЛЯ -->
            <Border Grid.Row="1" Background="{StaticResource App.SecondColor}" CornerRadius="6" Margin="5">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <!-- Наименование / Описание -->
                        <StackPanel Margin="5">
                            <TextBlock Text="Наимевание" FontSize="18" Margin="0 0 0 5" HorizontalAlignment="Center"/>

                            <cc:PlaceHolderTextBox Grid.Column="0" PlaceHolder="Наименование" Margin="0 0 0 5"
                                                   Text="{Binding PositionDis.Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                            <cc:PlaceHolderTextBox Grid.Column="0" PlaceHolder="Описание" Margin="0 0 0 0" TextWrapping="Wrap" MaxHeight="500"
                                                   Text="{Binding PositionDis.Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.PlaceHolder}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                        <Button Content="Сохранить" Margin="5"
                                HorizontalAlignment="Stretch"
                                Command="{Binding CreatePositionCommandAsync}"
                                Style="{StaticResource App.Button}"/>

                        <Button Content="Обновить"  Margin="5"
                                HorizontalAlignment="Stretch"
                                Command="{Binding UpdatePositionCommandAsync}"
                                Style="{StaticResource App.Button}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
